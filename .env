# Django Settings
SECRET_KEY=django-insecure-smart_memo_secret_key_change_in_production
DEBUG=True
LOCAL_RUN=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Docker dev container on port 5431)
POSTGRES_DB=ikon_db
POSTGRES_USER=ikon_user
POSTGRES_PASSWORD=ikon_pass
DB_HOST=localhost
DB_PORT=5431

# Redis Configuration (Docker dev container on port 6378)
REDIS_HOST=127.0.0.1
REDIS_PORT=6378
REDIS_PASSWORD=redis_pass

# Celery Configuration
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=2

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Security / JWT
ACCESS_TOKEN_DAYS=60
REFRESH_TOKEN_DAYS=60
OTP_EXPIRE_TIME=300
